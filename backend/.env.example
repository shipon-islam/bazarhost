NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/bazarhost

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
JWT_EXPIRES_DAYS=1

# Comma separated list of frontend origins allowed by CORS (and for cookie-auth CSRF checks)
CLIENT_URLS=http://localhost:3000

# Auth cookie. Use COOKIE_SAMESITE=none only if frontend and API are on different *sites* (requires HTTPS)
COOKIE_NAME=bz_admin_token
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.bazarhost.com

# Number of reverse proxies in front of the API (nginx, Render, etc.) so req.ip / rate limits work
TRUST_PROXY=0

# Public base URL of this API (used to build absolute upload URLs)
PUBLIC_URL=http://localhost:5000
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Used by `npm run seed`
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@bazarhost.com
# Leave empty to generate a random password (printed once in the console)
SEED_ADMIN_PASSWORD=
