# ---------------------------------------------------------------------------
# BazarHost Admin: environment template. Copy to .env.local and adjust.
# Never commit real secrets. Only NEXT_PUBLIC_* values reach the browser.
# ---------------------------------------------------------------------------

# Use the built-in in-memory mock service (true) or your real backend (false).
# NOTE: only the mock service is implemented today; see README "API integration".
NEXT_PUBLIC_USE_MOCK=true

# Artificial latency (ms) for mock calls so loading skeletons are visible.
NEXT_PUBLIC_MOCK_DELAY_MS=350

# Base URL of the real BazarHost API (used by lib/api.ts `request()` once wired up).
NEXT_PUBLIC_API_BASE_URL=https://api.bazarhost.com

# --- Authentication (SERVER-SIDE ONLY, never prefix with NEXT_PUBLIC_) -------
# There is no real auth in this repo yet. In development the admin layout uses a
# clearly-labelled mock user. In production the admin is LOCKED (Access Denied)
# unless you wire up real auth in src/lib/auth.ts.
# Set to "true" ONLY for local demos / staging previews. Never on a public host.
ALLOW_MOCK_AUTH=false
